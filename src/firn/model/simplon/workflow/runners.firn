// The runner kinds the kernel knows (si#267, si#857), as M1 instances of simplon.workflow.RunnerKind. A firn name
// has no `-`: `self_hosted_debian` is the kernel's `self-hosted-debian`. These were the hand-typed table in
// src/simplon/manifest/runners.py until si#857; the measurements behind them moved here with them.
//
// Every kind the kernel knows, and no more than were measured.
//
// `github-ubuntu` is what every product in this family used before 2026-09-16, and it is the shape the
// generator emitted by default: `actions/setup-python` works, docker is already on the machine.
//
// `self-hosted-debian` is `ghr-8`, measured on 2026-09-16 while moving this repository's CI onto it:
//
//   * `actions/setup-python` REFUSES. It does not install Python, it unpacks prebuilt archives, and its
//     manifest carries Ubuntu 22.04/24.04/26.04 and RHEL 9/10 and nothing else. The answer on a Debian
//     runner is "not found for this operating system" and no version pin could have changed it. The
//     machine's own `python3` is what the launcher builds its venv with, which is netctl's shape too.
//   * DOCKER ARRIVES THROUGH THE BOOTSTRAP. A container job was tried first and is not the answer: it
//     needs docker on the runner in order to START, so it cannot be the thing that gets docker onto the
//     runner. `DELIVERY_DOCKER_BOOTSTRAP=1` lets `simplon.adapters.docker.ensure_docker()` install the engine as
//     root, or fetch the static client when it is not root - docker-outside-of-docker, started from
//     inside the job.
//   * THE LABEL IS THE PRODUCT'S. `[self-hosted, Linux, X64]` would describe any self-hosted Linux
//     machine an account ever registers, so the day a second one joins the jobs are shared out with
//     nothing saying so. A label of the machine's own is the answer, and the kernel cannot know it.
//
// `self-hosted-container` is a self-hosted runner that is itself an LXC container: firn's `ghr-7` (#722, reported
// by firn's peer session on 2026-11-17) and `ghr-8` (Marco, 2026-11-25, si#863). It is `self-hosted-debian` in
// every fact above, and one more:
//
//   * EMULATION CANNOT BE REGISTERED FROM INSIDE IT. `tonistiigi/binfmt --install` is refused with `permission
//     denied` on `/proc/sys/fs/binfmt_misc/register` (si#358), and `docker/setup-qemu-action` runs exactly that.
//     So it is registered once, by hand and as root, with `support:ci-arm64`'s boot-time registration (si#358),
//     never by a step in a job. A derived CI job names the gap instead of the step (si#860); a release whose
//     `emulates:` would run here is refused at generation (#722).
package simplon.workflow.runners

github_ubuntu typeOf simplon.workflow.RunnerKind {
  labels = "ubuntu-latest"
  setup_python = true
  // Destroyed after every job, so there is no disk to look after.
  disk_persists = false
  can_emulate = true
  why = "GitHub-hosted Ubuntu: `actions/setup-python` unpacks an interpreter here, and docker is already on the machine."
}
self_hosted_debian typeOf simplon.workflow.RunnerKind {
  setup_python = false
  disk_persists = true
  can_emulate = true
  why = "A self-hosted Debian machine. `actions/setup-python` unpacks prebuilt archives and carries none for Debian, so the runner's own python3 is what the launcher builds its venv with; docker is reached through the bootstrap, because a container job would need docker in order to start."
  env e_bootstrap typeOf simplon.workflow.RunnerEnv {
    env_name = "DELIVERY_DOCKER_BOOTSTRAP"
    env_value = "1"
  }
}
self_hosted_container typeOf simplon.workflow.RunnerKind {
  setup_python = false
  disk_persists = true
  can_emulate = false
  why = "A self-hosted runner that is itself an LXC container. Python and docker are reached as on a self-hosted Debian machine; emulation cannot be registered from inside a job, because `/proc/sys/fs/binfmt_misc/register` is refused there (si#358, #722), so it is registered once by hand with `support:ci-arm64`."
  env e_bootstrap typeOf simplon.workflow.RunnerEnv {
    env_name = "DELIVERY_DOCKER_BOOTSTRAP"
    env_value = "1"
  }
}

// The platform cells a leaf's `platforms:` names (si#860), measured on cleon `ci.yml` and asbundle
// `build-matrix.yml` (2026-11-23): the runner label, what `uname -m` prints in bash there, and the shell. A firn name
// has no `-`: `linux_x64` is the kernel's `linux-x64`. `arch` is what `uname -m` prints in bash on the cell.
linux_x64 typeOf simplon.workflow.Platform {
  label = "ubuntu-24.04"
  arch = "x86_64"
  shell = "bash"
  windows = false
}
linux_arm64 typeOf simplon.workflow.Platform {
  label = "ubuntu-24.04-arm"
  arch = "aarch64"
  shell = "bash"
  windows = false
}
macos_x64 typeOf simplon.workflow.Platform {
  label = "macos-15-intel"
  arch = "x86_64"
  shell = "bash"
  windows = false
}
macos_arm64 typeOf simplon.workflow.Platform {
  label = "macos-15"
  arch = "arm64"
  shell = "bash"
  windows = false
}
windows_x64 typeOf simplon.workflow.Platform {
  label = "windows-2025"
  arch = "x86_64"
  shell = "cmd"
  windows = true
}
