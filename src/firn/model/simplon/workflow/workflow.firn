// simplon.workflow (si#857, the si#788 spec section 4, decision D5): the vocabulary of a derived GitHub workflow,
// written as a firn metamodel before the kernel derives anything from it. Marco chose "model first"
// (2026-11-22): the kernel's workflow classes are generated from here (src/firn/templates/workflowschema.firnt
// writes src/simplon/model/workflowschema.py), never typed by hand.
//
// THE PROPERTIES ARE READ, in this order: the template writes one frozen dataclass per class below and one field
// per property, so a property added here is a field there. Which leaves, which jobs and which order is decided in
// Python over those classes (the spec, section 4), not by selectors here.
package simplon.workflow

// A kind of machine a job runs on, and what follows from it (si#267). The instances are in runners.firn.
RunnerKind typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  // The labels the kind brings itself; a self-hosted kind brings none, and the product names its machine.
  property labels typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
  // Does `actions/setup-python` work on it.
  property setup_python typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 1..1
  }
  // Does the machine survive the job (si#327): a disk that can fill.
  property disk_persists typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 1..1
  }
  // Can a job on it register QEMU for an emulated platform (#722 reads it).
  property can_emulate typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 1..1
  }
  property why typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  // The environment every job on the kind gets.
  property env typeOf firn.core.Composition {
    range = simplon.workflow.RunnerEnv
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
}

// A platform cell a leaf can be spread over (si#860): the runner label, what `uname -m` prints in bash there, the
// shell and whether it is Windows. Measured on cleon `ci.yml` and asbundle `build-matrix.yml` (2026-11-23). The
// instances are in runners.firn.
Platform typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property label typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property arch typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property shell typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property windows typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 1..1
  }
}

// One variable of a runner kind's environment.
RunnerEnv typeOf firn.core.Class extends firn.core.NamedResource {
  property env_name typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property env_value typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
}

// A product's machine: a kind and the product's own labels (the manifest's top-level `runner:`, spec D4).
Runner typeOf firn.core.Class extends firn.core.NamedResource {
  property kind typeOf firn.core.Association {
    range = simplon.workflow.RunnerKind
    subjectCardinality = 1..1
    objectCardinality = 0..N
  }
  property labels typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
}

// What starts a workflow. `event` is one of `pull_request`, `push_main`, `dispatch` or `schedule`; a string, not an
// enum, so the template needs no enum case. `cron` belongs to `schedule`, `input` to `dispatch`.
Trigger typeOf firn.core.Class extends firn.core.NamedResource {
  property event typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property cron typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property input typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
}

// The cells of a job: platforms and Python versions (spec D8).
Matrix typeOf firn.core.Class extends firn.core.NamedResource {
  property platform typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
  property python typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
}

// One step: a product command, or a step the kernel owns (checkout, reaper, docker probe, disk preflight, upload,
// download, app-token mint). Exactly one of the two; a product cannot name a kernel step.
Step typeOf firn.core.Class extends firn.core.NamedResource {
  property command typeOf firn.core.Association {
    range = simplon.pipeline.TaskCommand
    subjectCardinality = 0..1
    objectCardinality = 0..N
  }
  property kernel_step typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  // GitHub's `timeout-minutes` on the step, from a leaf's `ci: { timeout_minutes: N }` (si#860).
  property timeout_minutes typeOf firn.core.Attribute {
    range = firn.core.IntegerLiteral
    subjectCardinality = 0..1
  }
}

// A gate on an aggregate (si#861): the changed paths (the `*`/`**` subset of GitHub's filter syntax), the PR label and the one ERE the kernel
// derived from the globs that the decide job greps with. Set on the decide job only.
Gate typeOf firn.core.Class extends firn.core.NamedResource {
  property paths typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
  property label typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property pattern typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
}

// One GitHub job: a machine, its steps in order, the jobs it needs, its cells, its condition and its time limit
// (si#720's default when absent).
Job typeOf firn.core.Class extends firn.core.NamedResource {
  // GitHub's job id, read for `jobs:` and `needs:` (#858).
  property key typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property runner typeOf firn.core.Composition {
    range = simplon.workflow.Runner
    subjectCardinality = 1..1
    objectCardinality = 0..1
  }
  property step typeOf firn.core.Composition {
    range = simplon.workflow.Step
    subjectCardinality = 1..N
    objectCardinality = 0..1
  }
  property needs typeOf firn.core.Association {
    range = simplon.workflow.Job
    subjectCardinality = 0..N
    objectCardinality = 0..N
  }
  property matrix typeOf firn.core.Composition {
    range = simplon.workflow.Matrix
    subjectCardinality = 0..1
    objectCardinality = 0..1
  }
  property condition typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property timeout_minutes typeOf firn.core.Attribute {
    range = firn.core.IntegerLiteral
    subjectCardinality = 0..1
  }
  // The decide job of a gate (si#861) carries it; no other job does.
  property gate typeOf firn.core.Composition {
    range = simplon.workflow.Gate
    subjectCardinality = 0..1
    objectCardinality = 0..1
  }
  // The literals a gate's `env:` puts on the gated job (si#861).
  property env typeOf firn.core.Composition {
    range = simplon.workflow.RunnerEnv
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
}

// One workflow file. `title` is GitHub's `name:` (every firn resource already has a `name`). No permissions or
// concurrency: both are kernel constants today (si#719), and nothing would read them from here yet.
Workflow typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property path typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property title typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property trigger typeOf firn.core.Composition {
    range = simplon.workflow.Trigger
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
  property job typeOf firn.core.Composition {
    range = simplon.workflow.Job
    subjectCardinality = 1..N
    objectCardinality = 0..1
  }
}

// A product-written workflow that names why no datum expresses it yet (spec section 6.3); the census counts it.
WorkflowException typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property path typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property reason typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
}
