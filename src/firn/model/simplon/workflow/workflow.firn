// simplon.workflow (si#857, the si#788 spec section 4, decision D5): the vocabulary of a derived GitHub workflow,
// written as a firn metamodel before the kernel derives anything from it. Marco chose "model first"
// (2026-11-22): the kernel's workflow classes are generated from here (src/firn/templates/workflowschema.firnt
// writes src/simplon/model/workflowschema.py), never typed by hand.
//
// THE PROPERTIES ARE READ, in this order: the template writes one frozen dataclass per class below and one field
// per property, so a property added here is a field there. Which leaves, which jobs and which order is decided in
// Python over those classes (the spec, section 4), not by selectors here.
package simplon.workflow

// A kind of machine a job runs on, and what follows from it (si#267). The instances are in runners.firn.
RunnerKind typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  // The labels the kind brings itself; a self-hosted kind brings none, and the product names its machine.
  property labels typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
  // Does `actions/setup-python` work on it.
  property setup_python typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 1..1
  }
  // Does the machine survive the job (si#327): a disk that can fill.
  property disk_persists typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 1..1
  }
  // Can a job on it register QEMU for an emulated platform (#722 reads it).
  property can_emulate typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 1..1
  }
  property why typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  // The environment every job on the kind gets.
  property env typeOf firn.core.Composition {
    range = simplon.workflow.RunnerEnv
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
}

// A platform cell a leaf can be spread over (si#860): the runner label, what `uname -m` prints in bash there, the
// shell and whether it is Windows. Measured on cleon `ci.yml` and asbundle `build-matrix.yml` (2026-11-23). The
// instances are in runners.firn.
Platform typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property label typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property arch typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property shell typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property windows typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 1..1
  }
}

// One variable of a runner kind's environment.
RunnerEnv typeOf firn.core.Class extends firn.core.NamedResource {
  property env_name typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property env_value typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
}

// A product's machine: a kind and the product's own labels (the manifest's top-level `runner:`, spec D4).
Runner typeOf firn.core.Class extends firn.core.NamedResource {
  property kind typeOf firn.core.Association {
    range = simplon.workflow.RunnerKind
    subjectCardinality = 1..1
    objectCardinality = 0..N
  }
  property labels typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
}

// What starts a workflow. `event` is one of `pull_request`, `push_main`, `dispatch`, `schedule` or `workflow_run`;
// a string, not an enum, so the template needs no enum case. `cron` belongs to `schedule`,
// `dispatch_input` to `dispatch`, `workflows` to `workflow_run`.
Trigger typeOf firn.core.Class extends firn.core.NamedResource {
  property event typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property cron typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  // The inputs a `dispatch` asks for, in the order the button shows them (si#862: the release's `version` and
  // `dry_run`; `cipipeline._on` writes them under `workflow_dispatch: inputs:`). It replaces a bare list of input
  // names that nothing read, which could say neither a type nor a default.
  property dispatch_input typeOf firn.core.Composition {
    range = simplon.workflow.DispatchInput
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
  // The workflows a `workflow_run` listens to, by their `name:` (GitHub matches names, not files) (si#874).
  property workflows typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
  // The activity types the event is narrowed to (`completed`, `labeled`); none is every type (si#874).
  property types typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
}

// One input of a `dispatch` trigger (si#862), as GitHub's `workflow_dispatch: inputs:` spells it: `input_type` is
// GitHub's `type:` (`string`, `boolean`), and `default_value` is GitHub's `default:` as text, which `cipipeline._on`
// writes as a boolean for a `boolean` input. Read by `cipipeline._on`.
DispatchInput typeOf firn.core.Class extends firn.core.NamedResource {
  property input_name typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property description typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property input_type typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property required typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 1..1
  }
  property default_value typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
}

// The GitHub environment a job deploys to (si#862): its name, and the URL the run links to, an expression a step
// of the job sets (`pages`' `steps.deployment.outputs.page_url`). Read by `releasepipeline.to_workflow`.
DeployEnvironment typeOf firn.core.Class extends firn.core.NamedResource {
  property environment_name typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property url typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
}

// One scope of a workflow's token (si#874): `contents`, `write`, and why the workflow needs it, which the rendered
// file says.
Permission typeOf firn.core.Class extends firn.core.NamedResource {
  property scope typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property access typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property reason typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
}

// The cells of a job: platforms and Python versions (spec D8).
Matrix typeOf firn.core.Class extends firn.core.NamedResource {
  property platform typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
  property python typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
}

// One step: a product command, or a step the kernel owns (checkout, reaper, docker probe, disk preflight, upload,
// download, app-token mint). Exactly one of the two; a product cannot name a kernel step.
Step typeOf firn.core.Class extends firn.core.NamedResource {
  property command typeOf firn.core.Association {
    range = simplon.pipeline.TaskCommand
    subjectCardinality = 0..1
    objectCardinality = 0..N
  }
  property kernel_step typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  // GitHub's `timeout-minutes` on the step, from a leaf's `ci: { timeout_minutes: N }` (si#860).
  property timeout_minutes typeOf firn.core.Attribute {
    range = firn.core.IntegerLiteral
    subjectCardinality = 0..1
  }
  // What the step hands its command, from a leaf's `ci: { params: }` (si#863), in the order written.
  property params typeOf firn.core.Composition {
    range = simplon.workflow.StepParam
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
  // GitHub's `if:` on the step (si#862): the release skips a `publishes:` leaf on a dry run and runs its dry-run
  // tail only on one. Read by `releasepipeline.to_workflow`; `cipipeline` writes its own conditions (`to_workflow`).
  property condition typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  // The step's own `env:` (si#862): a `token: github` leaf's GITHUB_TOKEN and an `env: pass:` leaf's secrets, each
  // an expression held as the value. Read by `releasepipeline.to_workflow`.
  property env typeOf firn.core.Composition {
    range = simplon.workflow.RunnerEnv
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
  // GitHub's `id:` on the step, for a later expression that reads its outputs (si#862). Read by
  // `releasepipeline.to_workflow`.
  property step_id typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
}

// One parameter a derived step hands its command (si#863): `param_value` a scalar's text, or `param_env` the name
// of a variable the shell expands, as a declared step's `params: { env: NAME }` (si#488). Exactly one of the two.
StepParam typeOf firn.core.Class extends firn.core.NamedResource {
  property param_name typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property param_value typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property param_env typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
}

// A gate on an aggregate (si#861): the changed paths (the `*`/`**` subset of GitHub's filter syntax), the PR label and the one ERE the kernel
// derived from the globs that the decide job greps with. Set on the decide job only.
Gate typeOf firn.core.Class extends firn.core.NamedResource {
  property paths typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
  property label typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property pattern typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
}

// What the kernel step `auto-merge` is given (si#874): the workflows whose runs for a commit decide the merge, by
// FILE, since the runs are asked for by file while `workflow_run` names them by `name:`. `ci_workflow` is the CI
// workflow's file, the one dispatched on the base after a merge; `triggers` is every trigger workflow's file, CI
// first; `labels` is each gate with a `label:`; `derived_gates` is the file of each gate workflow the kernel derives,
// whose decide job runs on every pull request event, so the merge asks for one of its runs (rule `derived-gate-ran`).
// The field names are the `source` of the merge policy's inputs (`simplon.automerge.MergeInput`).
Merge typeOf firn.core.Class extends firn.core.NamedResource {
  property ci_workflow typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property triggers typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..N
  }
  property derived_gates typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
  }
  property labels typeOf firn.core.Composition {
    range = simplon.workflow.GateLabel
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
}

// A gate's workflow file and the label that asks for its run (si#874, the merge's rule `gate-label-needs-run`).
GateLabel typeOf firn.core.Class extends firn.core.NamedResource {
  property workflow typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property label typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
}

// One GitHub job: a machine, its steps in order, the jobs it needs, its cells, its condition and its time limit
// (si#720's default when absent).
Job typeOf firn.core.Class extends firn.core.NamedResource {
  // GitHub's job id, read for `jobs:` and `needs:` (#858).
  property key typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property runner typeOf firn.core.Composition {
    range = simplon.workflow.Runner
    subjectCardinality = 1..1
    objectCardinality = 0..1
  }
  property step typeOf firn.core.Composition {
    range = simplon.workflow.Step
    subjectCardinality = 1..N
    objectCardinality = 0..1
  }
  property needs typeOf firn.core.Association {
    range = simplon.workflow.Job
    subjectCardinality = 0..N
    objectCardinality = 0..N
  }
  property matrix typeOf firn.core.Composition {
    range = simplon.workflow.Matrix
    subjectCardinality = 0..1
    objectCardinality = 0..1
  }
  property condition typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property timeout_minutes typeOf firn.core.Attribute {
    range = firn.core.IntegerLiteral
    subjectCardinality = 0..1
  }
  // The decide job of a gate (si#861) carries it; no other job does.
  property gate typeOf firn.core.Composition {
    range = simplon.workflow.Gate
    subjectCardinality = 0..1
    objectCardinality = 0..1
  }
  // The literals a gate's `env:` puts on the gated job (si#861).
  property env typeOf firn.core.Composition {
    range = simplon.workflow.RunnerEnv
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
  // The auto-merge job (si#874) carries it; no other job does.
  property merge typeOf firn.core.Composition {
    range = simplon.workflow.Merge
    subjectCardinality = 0..1
    objectCardinality = 0..1
  }
  // The job's own `concurrency:` group, queued and never cancelling a run in progress. Job-level, so only a run whose
  // job passes its `if:` takes it (si#874: a workflow-level group is taken before the `if:`, so a run that does
  // nothing could displace a pending one that would merge). Set on the auto-merge job; the renderer writes it there.
  property concurrency typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  // The job starts no container, so it gets no si#756 reap step (si#874 security review). That step falls back to a
  // docker binary in the job's workspace, which on a shared self-hosted machine is a previous job's leftover, run
  // here with this job's token. Set on the auto-merge job, whose token writes.
  property starts_no_container typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 0..1
  }
  // The job's own token scopes (si#719), which replace the workflow's for this job: the release job's
  // `contents: write` and `packages: write` (si#862). Read by `releasepipeline.to_workflow`.
  property permission typeOf firn.core.Composition {
    range = simplon.workflow.Permission
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
  // The GitHub environment the job deploys to (si#862: `github-pages`, `pypi`). Read by
  // `releasepipeline.to_workflow`.
  property environment typeOf firn.core.Composition {
    range = simplon.workflow.DeployEnvironment
    subjectCardinality = 0..1
    objectCardinality = 0..1
  }
  // The job takes no checkout (si#862: a deploy job that only hands on an artifact). Read by
  // `releasepipeline.to_workflow`.
  property no_checkout typeOf firn.core.Attribute {
    range = firn.core.BooleanLiteral
    subjectCardinality = 0..1
  }
}

// One workflow file. `title` is GitHub's `name:` (every firn resource already has a `name`). `permission` is the
// token's scopes where a workflow needs more than the kernel's least-privilege default (si#719), which an empty
// one keeps (si#874). No workflow-level concurrency: the renderer decides it per kind of file.
Workflow typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property path typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property title typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property trigger typeOf firn.core.Composition {
    range = simplon.workflow.Trigger
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
  property job typeOf firn.core.Composition {
    range = simplon.workflow.Job
    subjectCardinality = 1..N
    objectCardinality = 0..1
  }
  property permission typeOf firn.core.Composition {
    range = simplon.workflow.Permission
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
}

// A product-written workflow that names why no datum expresses it yet (spec section 6.3); the census counts it.
WorkflowException typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property path typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property reason typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
}
