// si#435 (decided 2026-10-15): deploy:up's input is bound by the manifest's `deploy: source:`, the section that
// already names what is deployed, and never by `consumes:` - so no `param`: the body reads the section itself.
// It accepts any artifact: a server deploys an image, a client installs a directory.
DeployUp typeOf simplon.pipeline.CatalogueTaskType extends simplon.pipeline.Task {
  key = "deploy:up"
  body = "simplon.tasks.deploy:up"
  property source typeOf simplon.pipeline.InputPort {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
    accepts = simplon.vocabulary.artifact
  }
}
ToolchainRun typeOf simplon.pipeline.CatalogueTaskType extends simplon.pipeline.Task {
  key = "toolchain:run"
  body = "simplon.tasks.toolchain:run_toolchain"
  property source typeOf simplon.pipeline.InputPort {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
    accepts = simplon.vocabulary.artifact
  }
  property out typeOf simplon.pipeline.OutputPort {
    range = firn.core.StringLiteral
    subjectCardinality = 0..N
    accepts = simplon.vocabulary.artifact
  }
}

