// simplon.pipeline (si#371, si#346): the metamodel of simplon's delivery pipeline, written for firn.
//
// What it says: a Task is a CLASS (si#400 4a) whose input and output Ports are its properties, each accepting
// an ArtifactKind; a TaskCommand is a filter instance that runs one Task class and REFERENCES what it produces and what it
// consumes: the Product owns every artifact, and several commands may produce one, but no plan holds two of
// them (si#344 C.2, decided 2026-10-14). A Group holds commands and
// belongs to one Area (ci, cd, support). Aggregates, releases, environments, sites and registries are
// modelled below; what a release publishes and what a test result is about are DERIVED (SelectorRelation).
//
// What the sketch got wrong, measured by `firn check` on firn v0.1.0: every Association needs an
// `objectCardinality`, which the sketch left out. `firn check` does not compile a selector: see
// src/tests/test_firn_pipeline_e2e.py, which asks every SelectorRelation for its value.
package simplon.pipeline

// ci | cd | support (spec D.1). Transparency is a property of the area, so it is not a key a group
// can carry.
enum Area { ci cd support }

ArtifactKind typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property refines typeOf firn.core.Association {
    range = simplon.pipeline.ArtifactKind
    subjectCardinality = 0..N
    objectCardinality = 0..N
  }
  // The keys an artifact of this kind may carry beyond the ones it inherits (si#344 B2). The generated
  // schema (src/firn/templates/schema.firnt) gives each one a field of its shape and refuses any other key.
  property field typeOf firn.core.Composition {
    range = simplon.pipeline.ArtifactField
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
}

// One key of an artifact kind and the SHAPE of its value (si#344 B2): text (a string or a number, read as
// a string), texts (a list of non-empty strings), table (a mapping of scalars) or untyped (kept as written
// - a key only a product reads). `key` is the manifest's spelling; the resource's own name carries an `f_`
// prefix, so no key can collide with a word firn reserves.
ArtifactField typeOf firn.core.Class extends firn.core.NamedResource {
  property key typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property shape typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
}

Registry typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property host typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
}

// A task's port (spec C.1): the kind it accepts (and every kind refining it), the body parameter that
// receives the bound artifact's NAME at run time, if any, and the keys that port NEEDS on the entry it
// reads (si#344 B2's requiredness, which belongs to the reader: `build:nuget-config` needs a registry only,
// `release:nuget` an image and a project too). Since si#344 C.1 the port IS the reader; B2's separate reader class is gone.
Port typeOf firn.core.Class extends firn.core.Attribute {
  property accepts typeOf firn.core.Association {
    range = simplon.pipeline.ArtifactKind
    subjectCardinality = 1..1
    objectCardinality = 0..N
  }
  property param typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property needs typeOf firn.core.Association {
    range = simplon.pipeline.ArtifactField
    subjectCardinality = 0..N
    objectCardinality = 0..N
  }
}

// A port is a PROPERTY of its task class (si#400 4a); its direction is its type, no longer the
// composition (`input`/`output`) it sat in. Its value is the bound entry's NAME, which is what a body
// receives today through `param`.
InputPort typeOf firn.core.Class extends simplon.pipeline.Port {}
OutputPort typeOf firn.core.Class extends simplon.pipeline.Port {}

// si#400 4a: a task is a CLASS. Its coordinate and its body are values on the class, so they live one storey
// up, on its metaclass (firn docs/03 §8.4). A task class without `key` is firn's E004 - decision 4 of the
// part 4 spec, a diagnosis, and it holds the catalogue too.
TaskType typeOf firn.core.Class extends firn.core.Class {
  property key typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 1..1
  }
  property body typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
}

// The PLATFORM's tasks: their own metaclass, so a template over the catalogue does not gather the
// product tasks that `support manifest model` writes into the same firn project (si#344 C.1's reason).
CatalogueTaskType typeOf firn.core.Class extends simplon.pipeline.TaskType {}

Task typeOf firn.core.Class extends firn.core.NamedResource {
  modifier = firn.core.InheritanceModifier.Abstract
}

Artifact typeOf firn.core.Class extends firn.core.NamedResource {
  property key typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property path typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property kind typeOf firn.core.Association {
    range = simplon.pipeline.ArtifactKind
    subjectCardinality = 1..1
    objectCardinality = 0..N
  }
  property registry typeOf firn.core.Association {
    range = simplon.pipeline.Registry
    subjectCardinality = 0..1
    objectCardinality = 0..N
  }
}

Command typeOf firn.core.Class extends firn.core.NamedResource {
  modifier = firn.core.InheritanceModifier.Abstract
  property key typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
}

TaskCommand typeOf firn.core.Class extends simplon.pipeline.Command {
  property task typeOf firn.core.Association {
    range = simplon.pipeline.TaskType
    subjectCardinality = 1..1
    objectCardinality = 0..N
  }
  property consumes typeOf firn.core.Association {
    range = simplon.pipeline.Artifact
    subjectCardinality = 0..N
    objectCardinality = 0..N
  }
  property produces typeOf firn.core.Association {
    range = simplon.pipeline.Artifact
    subjectCardinality = 0..N
    objectCardinality = 0..N
  }
}

// What a test result is ABOUT is derived from what its producer consumes, never declared (spec C.3).
// Its producer is whoever REFERENCES it through `produces`: since C.2 the Product owns the artifact, so
// `self.owner()` is the Product and the old `self.owner().consumes` answered empty. `.-produces` is firn's
// reverse navigation (docs/04 §3.2); `TaskCommand[produces == self]` was measured too (2026-10-14) and
// answers empty for a command that produces two artifacts - it compares the whole set, not membership.
TestResult typeOf firn.core.Class extends simplon.pipeline.Artifact {
  property about typeOf firn.core.SelectorRelation {
    range = simplon.pipeline.Artifact
    subjectCardinality = 0..N
    objectCardinality = 0..N
    selector = "self.-produces.consumes"
  }
}

AggregateCommand typeOf firn.core.Class extends simplon.pipeline.Command {
  property member typeOf firn.core.Association {
    range = simplon.pipeline.Command
    subjectCardinality = 1..N
    objectCardinality = 0..N
  }
  property produced typeOf firn.core.SelectorRelation {
    range = simplon.pipeline.Artifact
    subjectCardinality = 0..N
    objectCardinality = 0..N
    selector = "self.member.produces"
  }
}

// The bundle a release aggregate names (spec C.4). Its content is derived from the members.
Release typeOf firn.core.Class extends simplon.pipeline.Artifact {
  property published typeOf firn.core.SelectorRelation {
    range = simplon.pipeline.Artifact
    subjectCardinality = 0..N
    objectCardinality = 0..N
    selector = "self.owner().member.consumes"
  }
}

ReleaseCommand typeOf firn.core.Class extends simplon.pipeline.AggregateCommand {
  property release typeOf firn.core.Composition {
    range = simplon.pipeline.Release
    subjectCardinality = 1..1
    objectCardinality = 0..1
  }
}

Environment typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property key typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property next typeOf firn.core.Association {
    range = simplon.pipeline.Environment
    subjectCardinality = 0..1
    objectCardinality = 0..1
  }
}

Site typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
}

// `site` stays 0..1 until a kernel body reads it (spec, "What this is NOT").
Deploy typeOf firn.core.Class extends simplon.pipeline.TaskCommand {
  property environment typeOf firn.core.Association {
    range = simplon.pipeline.Environment
    subjectCardinality = 1..1
    objectCardinality = 0..N
  }
  property site typeOf firn.core.Association {
    range = simplon.pipeline.Site
    subjectCardinality = 0..1
    objectCardinality = 0..N
  }
}

Group typeOf firn.core.Class extends firn.core.NamedResource {
  allowRoot = true
  property key typeOf firn.core.Attribute {
    range = firn.core.StringLiteral
    subjectCardinality = 0..1
  }
  property area typeOf firn.core.Association {
    range = simplon.pipeline.Area
    subjectCardinality = 1..1
    objectCardinality = 0..N
  }
  property command typeOf firn.core.Composition {
    range = simplon.pipeline.Command
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
  property group typeOf firn.core.Composition {
    range = simplon.pipeline.Group
    subjectCardinality = 0..N
    objectCardinality = 0..1
  }
}
