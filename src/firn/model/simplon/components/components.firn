e_init typeOf simplon.architecture.Excluded {
  path = "__init__"
  reason = "The package itself; it imports `_version`, which is excluded too, and `kernel.moved`, whose alias it installs (si#399)."
}
e_version typeOf simplon.architecture.Excluded {
  path = "_version"
  reason = "Written by setuptools-scm; it imports nothing."
}
