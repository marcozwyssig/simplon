template Catalogue {

  // The kernel's catalogue (src/simplon/catalogue.yaml), generated WHOLE (si#561): `kinds:` from
  // simplon.vocabulary (spec B.2), `groups:` from groups.firn and `tasks:` from tasks.firn in simplon.catalogue.
  // It has no protected region, so a hand edit is lost on the next `build model` and `test generated` is red
  // over it first. The loader reads the YAML; the why of each entry is the `//` comments of the model.
  //
  // One `params:` entry, on a task or on a placed command. The strings are written double-quoted and as they
  // stand: no catalogue string holds a `"` or a `\` (si#561, measured), and one that did would be a YAML
  // error at load, not a quiet change.
  function param(p) {
    |${p.key}: { help: "${p.help}"<<if p.short>>, short: "${p.short}"<<end>><<if p.metavar>>, metavar: "${p.metavar}"<<end>><<if p.argument>>, argument: true<<end>> }
  }

  // One group and everything under it, at any depth: the template stops nowhere the model does not.
  function group(g) {
    |${g.name}:
    if g.transparent {
      |  transparent: true
    }
    if g.env_first {
      |  env_first: true
    }
    |  help: "${g.help}"
    if g.command {
      |  commands:
      for c : g.command {
        |    ${c.name.replace("_", "-")}:
        |      task: "${c.task.key}"
        if c.params {
          |      params:
          for p : c.params {
            |        ${@param(p)}
          }
        }
      }
    }
    if g.group {
      |  groups:
      for s : g.group {
        |    ${@group(s)}
      }
    }
  }

  // The `file` block stands outside every `for`, so a selector that answers nothing can empty a section but
  // never drop the file.
  file "catalogue.yaml" language yaml {
    |# GENERATED by `./simplon.sh build model` from simplon's firn model: `kinds:` from
    |# src/firn/model/simplon/vocabulary/kinds.firn, `groups:` and `tasks:` from src/firn/model/simplon/catalogue/
    |# (groups.firn, tasks.firn), where the comments that say why each entry is what it is live. Do not edit.
    |kinds:
    for k : `simplon.pipeline.ArtifactKind` {
      if k.refines {
        |  ${k.name.replace("_", "-")}: { refines: <<for r : k.refines sep ", ">>${r.name.replace("_", "-")}<<end>> }
      }
      if not k.refines {
        |  ${k.name.replace("_", "-")}: {}
      }
    }
    |
    |groups:
    for g : `simplon.pipeline.CatalogueGroup`[not .owner()] {
      |  ${@group(g)}
    }
    |
    |tasks:
    for t : `simplon.pipeline.CatalogueTask` {
      |  ${t.key}:
      |    help: "${t.help}"
      |    unattended: ${t.unattended}
      if t.publishes {
        |    publishes: true
      }
      if t.token {
        |    token: ${t.token}
      }
      if t.passthrough_args {
        |    passthrough_args: true
      }
      if t.params {
        |    params:
        for p : t.params {
          |      ${@param(p)}
        }
      }
    }
  }
}
