template Docs {

  // The kinds reference page of the website (spec B.2). `language html`: firn has no markdown language
  // (E200 on v0.1.0), and html gives the id line as an html comment. A line starting with `|` in the
  // output needs `||`, because the first `|` is the template's output marker.
  file "kinds.md" language html {
    |---
    |title: "Artifact kinds"
    |weight: 6
    |---
    |
    |GENERATED from `src/firn/model/simplon/vocabulary/kinds.firn` (the kinds) and
    |`src/firn/model/simplon/catalogue/tasks.firn` (the ports) by `./simplon.sh build model`.
    |
    |An artifact names its kind; a port accepts a kind and every kind that refines it.
    |
    || Kind | Refines |
    ||---|---|
    for k : `simplon.pipeline.ArtifactKind` {
      if k.refines {
        || `${k.name.replace("_", "-")}` | <<for r : k.refines sep ", ">>`${r.name.replace("_", "-")}`<<end>> |
      }
      if not k.refines {
        || `${k.name.replace("_", "-")}` |  |
      }
    }
    |
    |## Ports
    |
    |A catalogue task takes and gives artifacts through its ports. A port accepts a kind and every kind that
    |refines it; a port that binds a parameter receives the bound artifact's name in it.
    |
    |A manifest cannot bind a port yet: `produces:` and `consumes:` on a command arrive with a later release
    |(si#344 C.2). Until then a command still selects its artifact with `with: { name: ... }`.
    |
    || Task | Port | Direction | Accepts | Binds |
    ||---|---|---|---|---|
    for t : `simplon.pipeline.CatalogueTask` {
      for p : t.input {
        if p.param {
          || `${t.key}` | `${p.name}` | input | `${p.accepts.name.replace("_", "-")}` | `${p.param}` |
        }
        if not p.param {
          || `${t.key}` | `${p.name}` | input | `${p.accepts.name.replace("_", "-")}` |  |
        }
      }
      for p : t.output {
        if p.param {
          || `${t.key}` | `${p.name}` | output | `${p.accepts.name.replace("_", "-")}` | `${p.param}` |
        }
        if not p.param {
          || `${t.key}` | `${p.name}` | output | `${p.accepts.name.replace("_", "-")}` |  |
        }
      }
    }
  }
}
